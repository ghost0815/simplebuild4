Screen {
    background: $surface;
}

#content {
    height: 1fr;
    padding: 0;
}

#target-bar {
    height: 3;
    padding: 0;
}

#target-bar .label {
    width: 10;
    padding: 1 0;
}

#target-select {
    width: 30%;
}

#build-opts {
    width: 1fr;
    margin: 0 0 0 1;
}

#target-bar Button {
    min-width: 12;
    margin: 0 0 0 1;
}

#info {
    margin: 1 0;
    padding: 1 1;
    height: auto;
    max-height: 50%;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#info:focus {
    border: heavy $primary;
}

/* Border title is a clickable toggle — subtle background tint only on
   the title itself, so the interactive hot-spot is where the click is. */
#info:hover {
    border-title-background: $primary-lighten-1;
}

#info-text {
    height: auto;
    width: 1fr;
}

#artifacts {
    margin: 1 0;
    padding: 1 1;
    height: 1fr;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    scrollbar-gutter: stable;
}

#artifacts:focus {
    border: heavy $primary;
}

#output {
    margin: 1 0;
    height: 1fr;
    background: $boost;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-gutter: stable;
    overflow-y: auto;
}

#output:focus {
    border: heavy $accent;
}

#main-tab-bar, #repo-tab-bar {
    height: 1;
    margin: 1 0 0 0;
}

/* Target editor tabs */
#te-tab-bar {
    height: 1;
    padding: 0 0 0 1;
}

#te-panel-general, #te-panel-source, #te-panel-oscam, #te-panel-upload {
    padding: 1 0;
}

.mod-grid {
    grid-size: 4;
    grid-gutter: 0 1;
    height: auto;
    padding: 0;
}

.opts-toggle-row {
    height: 1;
    margin: 0;
    padding: 0;
}

Switch.section-switch.-on > .switch--slider {
    color: $primary;
}

Switch.section-switch.all-on.-on > .switch--slider {
    color: $success;
}

.opts-toggle-btn {
    min-width: 8;
    max-width: 12;
    height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: $surface;
    color: $foreground;
}

.opts-toggle-btn:hover {
    background: $primary;
    color: $text;
}

.s-compact {
    height: 1;
    width: 1fr;
    padding: 0;
}

.mod-grid > .s-compact.row-odd {
    background: #1f1f1f;
}

.mod-grid > .s-compact.row-even {
    background: #2a2a2a;
}

.s-compact Switch {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
}

.sc-label {
    width: 1fr;
    height: 1;
    padding: 0;
}

.src-row {
    height: 4;
    padding: 0 1;
}

.src-row Switch {
    width: auto;
}

.src-name {
    width: 55;
    padding: 1 0;
}

.src-opt-label {
    width: auto;
    padding: 1 1;
}

.flag-label {
    width: 30;
    padding: 1 0;
}

.patch-grid {
    margin: 0 0 1 2;
}

.up-grid {
    grid-size: 2;
    grid-columns: 9fr 11fr;
    overflow: hidden;
    grid-rows: 3 3 3 3 3;
    height: auto;
}

.up-grid Select {
    width: 1fr;
}

.tc-toggle-row {
    height: 3;
}

.tc-toggle-cell {
    width: 1fr;
    height: 3;
}

.tc-toggle-label {
    width: 1fr;
    padding: 1 0;
}

.tc-editing {
    background: $accent;
    color: $text;
}

.tc-flags-header {
    height: 1;
    margin: 1 0 0 2;
    color: $accent;
}

.tc-fields-row {
    height: 3;
    padding: 0 2 0 4;
    margin: 0;
}
.tc-fields-row-first {
    height: 3;
    padding: 0 0 0 2;
    margin: 1 0 0 0;
}
.tc-fields-row-last {
    height: 3;
    padding: 0 2 0 4;
    margin: 0 0 1 0;
}
.tc-fields-grid {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    height: 3;
    padding: 0;
    margin: 0;
}
.tc-fields-grid-last {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    height: 3;
    padding: 0;
    margin: 0 0 1 0;
}
.tc-fields-grid Input, .tc-fields-grid-last Input {
    width: 1fr;
}

.tc-field-label {
    width: 15;
    padding: 1 0;
    text-align: right;
}

.tc-fields-row Input, .tc-fields-row-first Input, .tc-fields-row-last Input {
    width: 1fr;
}

.tc-default {
    color: $text-muted;
}

.tc-reset-btn {
    min-width: 4;
    max-width: 4;
    height: 3;
    margin: 0;
    padding: 0;
}

/* Settings & shared form styles */
#settings-content {
    padding: 1 0;
}

CollapsibleTitle {
    color: $text;
}

Collapsible:focus-within > CollapsibleTitle {
    text-style: bold;
}

.section-title {
    height: 1;
    margin: 1 0 0 0;
    color: $accent;
}

.section-title-top {
    height: 1;
    margin: 0;
    color: $accent;
}

.s-row {
    height: 3;
    margin: 0 0 0 2;
}

.s-row Input {
    width: 1fr;
}

.s-row Select {
    width: 30;
}

.s-row-tall {
    height: 3;
    margin: 0 0 0 2;
}

.s-label {
    width: 30;
    padding: 1 0;
}

.s-label-tall {
    width: 30;
    padding: 1 0;
}

.s-toggle {
    height: 3;
    margin: 0 0 0 2;
}

.s-toggle-grid {
    grid-size: 2;
    grid-columns: 5fr 5fr;
    grid-gutter: 0;
    height: auto;
    margin: 0 0 0 2;
}

.s-toggle-cell {
    height: 3;
}

.s-toggle-label {
    width: 30;
    padding: 1 0;
}

#web-svc-buttons {
    margin: 0 0 0 2;
}

#web-btn-gap, #mcp-btn-gap {
    width: 1fr;
}

.web-btn-row {
    height: 3;
}

.web-btn-row Button {
    width: 18;
    margin: 0 1 0 0;
}

.web-grid {
    grid-size: 2;
    grid-columns: 5fr 5fr;
    grid-rows: auto;
    grid-gutter: 0;
    height: auto;
    margin: 0;
}

#web-toggle-row {
    margin: 0 0 0 2;
}

#web-embedded-status {
    padding: 1 0 0 1;
}

.web-svc-status-label {
    width: 31;
    height: 3;
    padding: 1 0 0 0;
    color: $text-muted;
}

.s-label-rp {
    width: 14;
    padding: 1 1 0 2;
}


.flag-row {
    height: 3;
    margin: 0 0 0 2;
}

.flag-row Switch {
    margin: 0 6 0 0;
}

.s-toggle .s-label {
    width: 30;
    padding: 1 0;
}

/* Repository screen */
#repo-scroll, #repo-patches-scroll {
    padding: 0;
}

#patches-box {
    margin: 1 0;
    padding: 1 1;
    height: auto;
    max-height: 50%;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    overflow-y: auto;
}

#patches-box:focus {
    border: heavy $primary;
}

#repo-info {
    margin: 1 0;
    padding: 1 1;
    height: auto;
    max-height: 50%;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#repo-info-text {
    height: auto;
    width: 1fr;
}

#repo-info:focus {
    border: heavy $primary;
}

/* Border title is a clickable toggle — subtle background tint only on
   the title itself, so the interactive hot-spot is where the click is. */
#repo-info:hover {
    border-title-background: $primary-lighten-1;
}

#repo-output {
    margin: 1 0;
    height: 10;
    background: $boost;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
    padding: 0 1;
    overflow-y: auto;
}

#repo-output:focus {
    border: heavy $accent;
}

.repo-section {
    height: 1;
    margin: 1 1 0 2;
    color: $accent;
}

#repo-box {
    margin: 1 1;
    border: solid #444444;
    border-title-color: $text;
    height: auto;
    padding: 1 1;
}

#repo-box:focus-within {
    border: heavy #444444;
    border-title-style: bold;
}

#col-edit {
    margin: 1 1;
}

#re-box {
    margin: 1 0;
    padding: 1 1;
    height: 1fr;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    scrollbar-gutter: stable;
}

#re-box:focus {
    border: heavy $primary;
}

#repo-bar {
    height: 3;
    padding: 0;
}

#repo-bar .label {
    width: 13;
    padding: 1 0;
}

#repo-select {
    width: 30%;
}

#repo-bar Button {
    min-width: 12;
    margin: 0 0 0 1;
}

.repo-actions-row {
    height: 3;
    align: right middle;
}

.repo-actions-row Button {
    margin: 0 0 0 1;
}

.repo-actions-row Select {
    width: 25;
}

Switch .switch--slider {
    color: #666666;
    background: #444444;
}

Switch.-on .switch--slider {
    color: $success;
}

.spacer {
    width: 1fr;
}

.repo-label-short {
    width: 18;
    padding: 1 0;
}

.repo-auth-select {
    width: 24;
    min-width: 24;
    max-width: 24;
}

.input-fixed {
    width: 30;
}

.patch-info {
    margin: 0 2;
    padding: 0 1;
    height: auto;
}

#col-patches {
    margin: 1 1;
}

#patch-grid {
    grid-size: 3;
    grid-gutter: 0 2;
    height: auto;
    padding: 0 1;
}

.patch-toggle-row {
    grid-size: 3;
    grid-gutter: 0 2;
    height: auto;
    padding: 0 1;
}

.patch-item {
    height: 1;
    background: #252530;
    margin: 0;
}

.patch-item Switch {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
}

.patch-name {
    width: 1fr;
    height: 1;
}

/* Toolchains screen */
#tc-main {
    height: 1fr;
    margin: 0 0 1 0;
}

#tc-browser-wrap {
    width: 1fr;
}

#tc-installed-box {
    height: auto;
    max-height: 50%;
    margin: 1 0 0 0;
    border: solid #444444;
    border-title-color: $text;
    padding: 1 1;
    overflow-y: auto;
}

#tc-installed-box:focus-within {
    border: heavy #444444;
    border-title-style: bold;
}

#tbl-installed {
    height: auto;
    scrollbar-gutter: stable;
}

#tc-left-tab-bar {
    height: 1;
    margin: 0;
}

#tc-browser {
    height: 1fr;
    margin: 0;
    border: solid #444444;
}

#tc-selfbuild {
    display: none;
    height: 1fr;
    margin: 0;
    border: solid #444444;
}

#tc-browser:focus-within,
#tc-selfbuild:focus-within {
    border: heavy #444444;
}

#tc-browser S4DataTable, #tc-selfbuild S4DataTable {
    height: auto;
    max-height: 15;
    border-left: solid #444444;
    border-right: solid #444444;
}

#tc-browser Collapsible, #tc-selfbuild Collapsible {
    padding: 0;
    margin: 0;
}


#tc-right {
    width: 1fr;
    padding: 0;
}

#tc-actions {
    height: 3;
    margin: 0;
}

#tc-actions Button {
    margin: 0 0 0 1;
    min-width: 12;
    max-width: 12;
}

#tc-tab-bar {
    height: 1;
    padding: 0 0 0 1;
}

#tc-filter {
    width: 20;
}

#tc-libs-header {
    height: 0;
    margin: 0;
}

#lib-header-row {
    height: 1;
}

#lib-header-row Static {
    height: 1;
    padding: 0;
}

.tab-active {
    width: auto;
    height: 1;
    padding: 0 2;
    text-style: bold;
    color: $text;
    background: #444444;
}

.tab-inactive {
    width: auto;
    height: 1;
    padding: 0 2;
    color: $text-disabled;
}

.tab-inactive:hover {
    color: $text;
    background: #333333;
}

#tc-libs {
    margin: 0;
    padding: 1 1;
    height: auto;
    border: solid #444444;
    border-title-color: $accent;
    border-title-style: bold;
    overflow-x: hidden;
}

#tc-detail {
    margin: 0;
    padding: 0 1;
    height: 1fr;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
    overflow-x: hidden;
    overflow-y: auto;
}

#tc-detail:focus {
    border: heavy $primary;
}

TextArea#tc-editor {
    display: none;
    margin: 0;
    padding: 0;
    height: 1fr;
    background: $boost;
    border: solid $primary;
}

TextArea#tc-editor:focus {
    background: $surface;
    border: heavy $primary;
}

#tc-libs {
    display: none;
    padding: 0 1;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
}

#tc-libs:focus-within {
    border: heavy $primary;
}

.lib-header-row {
    height: 1;
    margin: 0 0 1 0;
    text-style: bold;
}

.lib-action-row {
    height: 3;
}

.lib-status {
    width: 35;
    padding: 1 0;
}

.lib-select {
    width: 1fr;
}

.lib-action-label {
    width: auto;
    padding: 1 0;
}

.lib-skip-all {
    width: auto;
    padding: 1 2;
    color: $text-muted;
}

.lib-skip-all:hover {
    color: $text;
}

#tc-output {
    margin: 0;
    height: 1fr;
    background: $boost;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
    padding: 0 1;
    overflow-y: auto;
}

#tc-output:focus {
    border: heavy $accent;
}

#edit-repo-branch {
    width: 1fr;
}

.repo-row-spacer {
    width: 4;
    min-width: 4;
    max-width: 4;
}
