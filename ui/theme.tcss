Screen {
    background: $surface;
}

#content {
    height: 1fr;
    padding: 0 1;
}

#target-bar {
    height: 3;
    padding: 0 1;
}

#target-bar .label {
    width: 10;
    padding: 1 0;
}

#target-select {
    width: 1fr;
}

#target-bar Button {
    min-width: 12;
    margin: 0 0 0 1;
}

#info {
    margin: 1 2;
    padding: 1 1;
    height: auto;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
}

#output {
    margin: 1 2;
    height: 1fr;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
}

/* Settings & shared form styles */
#settings-content {
    padding: 1 3;
}

.section-title {
    height: 1;
    margin: 1 0 0 0;
    color: $accent;
}

.section-title-top {
    height: 1;
    margin: 0;
    color: $accent;
}

.s-row {
    height: 3;
    margin: 0 0 0 2;
}

.s-row Input {
    width: 1fr;
}

.s-row Select {
    width: 40;
}

.s-row-tall {
    height: 3;
    margin: 0 0 0 2;
}

.s-label {
    width: 40;
    padding: 1 0;
}

.s-label-tall {
    width: 40;
    padding: 1 0;
}

.s-toggle {
    height: 3;
    margin: 0 0 0 2;
}

.s-toggle .s-label {
    width: 40;
    padding: 1 0;
}

/* Repository screen */
#repo-scroll {
    padding: 0 1;
}

#repo-info {
    margin: 0 1;
    padding: 1 1;
    height: auto;
    background: $boost;
    border: solid $primary;
    border-title-color: $text;
    border-title-style: bold;
}

#repo-output {
    margin: 0 1;
    height: 10;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
    padding: 0 1;
}

.repo-section {
    height: 1;
    margin: 1 1 0 2;
    color: $accent;
}

#repo-box {
    margin: 1 1;
    border: solid #444444;
    border-title-color: $accent;
    border-title-style: bold;
    height: auto;
    padding: 0 1;
}

#edit-box {
    margin: 1 1;
    border: solid #444444;
    border-title-color: $accent;
    border-title-style: bold;
    height: auto;
    padding: 0 1;
}

.repo-actions-row {
    height: 3;
    align: right middle;
}

.repo-actions-row Button {
    margin: 0 0 0 1;
}

.repo-actions-row Select {
    width: 25;
}

Switch .switch--slider {
    color: #666666;
    background: #444444;
}

Switch.-on .switch--slider {
    color: $success;
}

.spacer {
    width: 1fr;
}

.repo-label-short {
    width: 14;
    padding: 1 0;
}

.input-fixed {
    width: 30;
}

.patch-info {
    margin: 0 2;
    padding: 0 1;
    height: auto;
}

#patch-grid {
    grid-size: 2;
    grid-gutter: 0 2;
    margin: 1 1;
    height: auto;
    border: solid #444444;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

.patch-item {
    height: 1;
    background: #252530;
    margin: 0;
}

.patch-item Switch {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
}

.patch-name {
    width: 1fr;
    height: 1;
}

/* Toolchains screen */
#tc-main {
    height: 1fr;
}

#tc-browser {
    width: 1fr;
    padding: 0 1;
}

#tc-browser DataTable {
    height: auto;
    max-height: 15;
}

#tc-right {
    width: 1fr;
    padding: 0 1;
}

#tc-actions {
    height: 3;
    align: right middle;
}

#tc-actions Button {
    margin: 0 0 0 1;
}

#tc-tab-bar {
    height: 1;
    margin: 0 0 0 0;
}

.tab-active {
    width: auto;
    height: 1;
    padding: 0 2;
    text-style: bold;
    color: $text;
    background: #444444;
}

.tab-inactive {
    width: auto;
    height: 1;
    padding: 0 2;
    color: $text-disabled;
}

.tab-inactive:hover {
    color: $text;
    background: #333333;
}

#tc-libs {
    margin: 0;
    padding: 1 1;
    height: auto;
    border: solid #444444;
    border-title-color: $accent;
    border-title-style: bold;
    overflow-x: hidden;
}

#tc-detail {
    margin: 0;
    padding: 0 1;
    height: auto;
    border: solid #444444;
    overflow-x: hidden;
}

#tc-libs {
    display: none;
    padding: 0 1;
}

.lib-header-row {
    height: 1;
    margin: 0 0 1 0;
    text-style: bold;
}

.lib-action-row {
    height: 3;
}

.lib-status {
    width: 35;
    padding: 1 0;
}

.lib-select {
    width: 1fr;
}

#tc-output {
    margin: 0;
    height: 1fr;
    border: solid $accent;
    padding: 0 1;
}

.repo-row {
    height: 3;
    margin: 0 1;
}

.repo-label {
    width: 25;
    padding: 1 0;
}

.repo-row Input {
    width: 1fr;
}
