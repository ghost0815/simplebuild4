#!/bin/bash
# SimpleBuild4 launcher
cd "$(dirname "$(readlink -f "$0")")"

# --- Self-update (./s4 update [sha|branch|tag]) — no Python needed ---
if [ "$1" == "update" ]; then
    TARGET="$2"
    echo -e "\n  s4 self-update"
    echo -e "  ==============\n"

    if [ -d .git ]; then
        # --- Git repo: fetch + reset ---
        GIT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo master)"
        git fetch --prune --tags 2>&1 | sed 's/^/  /'

        local_rev=$(git rev-list HEAD --count)
        local_commit=$(git log HEAD -n1 --oneline)
        echo "  Local:  r$local_rev $local_commit"

        if [ -n "$TARGET" ]; then
            # --- Specific target: sha, branch or tag ---
            # Verify target exists
            if ! git rev-parse --verify "$TARGET" >/dev/null 2>&1; then
                echo -e "  \033[1;31mTarget '$TARGET' not found\033[0m"
                exit 1
            fi
            target_commit=$(git log "$TARGET" -n1 --oneline 2>/dev/null)
            echo "  Target: $target_commit"
            echo ""

            git checkout . 2>/dev/null
            git clean -fd 2>/dev/null

            echo "  Updating to $TARGET..."
            git reset --hard "$TARGET" 2>&1 | sed 's/^/  /'
        else
            # --- Latest: pull or reset ---
            ahead=$(git rev-list "origin/$GIT_BRANCH..HEAD" --count 2>/dev/null || echo 0)
            behind=$(git rev-list "HEAD..origin/$GIT_BRANCH" --count 2>/dev/null || echo 0)
            online_rev=$(git rev-list "origin/$GIT_BRANCH" --count 2>/dev/null || echo "?")
            online_commit=$(git log "origin/$GIT_BRANCH" -n1 --oneline 2>/dev/null || echo "?")

            if [ "$behind" -eq 0 ] && [ "$ahead" -eq 0 ]; then
                echo -e "  \033[1;32ms4 is up to date\033[0m"
                echo "  Revision $local_rev: $local_commit"
                exit 0
            fi

            echo "  Online: r$online_rev $online_commit"
            echo ""
            git log "HEAD..origin/$GIT_BRANCH" --oneline 2>/dev/null | sed 's/^/    /'
            echo ""

            git checkout . 2>/dev/null
            git clean -fd 2>/dev/null

            if [ "$ahead" -gt 0 ]; then
                echo "  Resetting to remote (forced push detected)..."
                git reset "origin/$GIT_BRANCH" --hard 2>&1 | sed 's/^/  /'
            else
                echo "  Pulling updates..."
                git pull 2>&1 | sed 's/^/  /'
            fi
        fi

        new_rev=$(git rev-list HEAD --count)
        new_commit=$(git log HEAD -n1 --oneline)
        echo -e "\n  \033[1;32mUpdated to r$new_rev: $new_commit\033[0m"

        # Container mode: persist HEAD SHA in the data volume so the
        # entrypoint re-applies it after `docker rm && docker run`.
        # See docker/entrypoint.py::_sync_to_target_sha.
        if [ "$S4_IN_CONTAINER" = "1" ] && [ -d data ]; then
            git rev-parse HEAD > data/s4-target-sha 2>/dev/null && \
                echo "  Container: this update will persist across container restarts."
        fi
    else
        # --- No git repo: clone to temp, copy files over (like s3) ---
        S4_URL="https://git.streamboard.tv/common/simplebuild4.git"
        # Try reading URL from settings
        [ -f data/settings.yaml ] && _url=$(grep 's4_url:' data/settings.yaml 2>/dev/null | awk '{print $2}') && [ -n "$_url" ] && S4_URL="$_url"

        echo "  No git repo — updating from $S4_URL"
        S4_TMP="/tmp/s4_update_$$"
        rm -rf "$S4_TMP"

        echo "  Cloning..."
        if ! git clone --depth 1 "$S4_URL" "$S4_TMP" 2>&1 | sed 's/^/  /'; then
            echo -e "  \033[1;31mClone failed\033[0m"
            rm -rf "$S4_TMP"
            exit 1
        fi

        echo "  Updating files..."
        # Copy everything except data/ directory
        for item in "$S4_TMP"/*; do
            name="$(basename "$item")"
            [ "$name" == "data" ] && continue
            [ "$name" == ".git" ] && continue
            rm -rf "./$name"
            cp -rf "$item" "./$name"
            echo "    $name"
        done
        # Hidden files (.gitignore, .gitattributes)
        for item in "$S4_TMP"/.[!.]*; do
            name="$(basename "$item")"
            [ "$name" == ".git" ] && continue
            cp -f "$item" "./$name"
            echo "    $name"
        done

        chmod +x ./s4 2>/dev/null
        rm -rf "$S4_TMP"

        online_rev=$(cd /tmp && git ls-remote "$S4_URL" HEAD | cut -c1-8)
        echo -e "\n  \033[1;32mUpdated to $online_rev\033[0m"
    fi

    # --- Restart background services so they pick up the new code ---
    # We only restart services whose WorkingDirectory points to this s4 root,
    # so multiple parallel s4 installs don't trample on each other.
    if command -v systemctl >/dev/null 2>&1; then
        here="$(pwd)"
        for svc_glob in "/etc/systemd/system/s4-web*.service" "/etc/systemd/system/s4-mcp*.service"; do
            for unit in $svc_glob; do
                [ -f "$unit" ] || continue
                grep -q "WorkingDirectory=$here" "$unit" 2>/dev/null || continue
                svc="$(basename "$unit" .service)"
                if systemctl is-active --quiet "$svc"; then
                    echo "  Restarting $svc..."
                    sudo -n systemctl restart "$svc" 2>/dev/null \
                        && echo "    done" \
                        || echo "    [warn] restart failed (sudo required?)"
                fi
            done
        done
    fi
    echo ""
    exit 0
fi

# --- Find Python 3.10+ ---
PYTHON=""
for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$py" &>/dev/null; then
        ver=$("$py" -c "import sys; print(sys.version_info >= (3,10))" 2>/dev/null)
        if [ "$ver" == "True" ]; then
            PYTHON="$py"
            break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    echo -e "\n  s4 requires Python 3.10 or newer."
    echo "  Found: $(python3 --version 2>/dev/null || echo 'none')"
    echo "  Install Python 3.10+ or compile from source."
    exit 1
fi

# --- MCP subcommand: install mcp (+ starlette/uvicorn for HTTP modes) + run ---
# No textual dependency needed — kept lightweight for headless hosts.
if [ "$1" == "mcp" ]; then
    shift
    MCP_OK=$($PYTHON -c "import mcp; print('ok')" 2>/dev/null)
    if [ "$MCP_OK" != "ok" ]; then
        echo "  Installing MCP Python SDK..."
        $PYTHON -m pip install --user --upgrade mcp 2>/dev/null \
            || $PYTHON -m pip install --user --upgrade --break-system-packages mcp 2>/dev/null \
            || { echo "  pip install mcp failed"; exit 1; }
    fi
    # HTTP extras (starlette + uvicorn) only needed for SSE / Streamable HTTP
    NEEDS_HTTP=0
    PREV=""
    for arg in "$@"; do
        case "$arg" in
            --http) NEEDS_HTTP=1 ;;
            --transport=sse|--transport=http) NEEDS_HTTP=1 ;;
        esac
        if [ "$PREV" == "--transport" ] && { [ "$arg" == "sse" ] || [ "$arg" == "http" ]; }; then
            NEEDS_HTTP=1
        fi
        PREV="$arg"
    done
    if [ "$NEEDS_HTTP" == "1" ]; then
        HTTP_OK=$($PYTHON -c "import starlette, uvicorn; print('ok')" 2>/dev/null)
        if [ "$HTTP_OK" != "ok" ]; then
            echo "  Installing starlette + uvicorn for HTTP transport..."
            $PYTHON -m pip install --user --upgrade starlette uvicorn 2>/dev/null \
                || $PYTHON -m pip install --user --upgrade --break-system-packages starlette uvicorn 2>/dev/null \
                || { echo "  pip install starlette uvicorn failed"; exit 1; }
        fi
    fi
    exec $PYTHON -m mcp_server "$@"
fi

# --- Minimal Python bootstrap ---
#
# We only need PyYAML at this stage so the dependency checker can read
# defaults/dependencies.yaml — everything else (textual, mcp, …) is
# resolved by the in-app DependencyCheckModal which runs in the user's
# context, never as root, and obeys the version constraints declared
# in the YAML. Keeps this script short and the source-of-truth single.
YAML_OK=$($PYTHON -c "import yaml" 2>/dev/null && echo ok)
TEXTUAL_OK=$($PYTHON -c "
try:
    import textual
    v = tuple(int(x) for x in textual.__version__.split('.')[:2])
    print('ok' if v >= (5, 0) else 'old')
except ImportError:
    print('missing')
" 2>/dev/null)

if [ "$YAML_OK" != "ok" ] || [ "$TEXTUAL_OK" != "ok" ]; then
    echo ""
    [ "$YAML_OK" != "ok" ] && echo "  pyyaml: not installed"
    [ "$TEXTUAL_OK" = "missing" ] && echo "  textual: not installed"
    [ "$TEXTUAL_OK" = "old" ] && echo "  textual: too old (need >= 5.0)"

    # Make sure pip itself is available — on minimal containers / fresh
    # installs it can be missing. Falling back to the distro package
    # manager is the only way to bootstrap pip without manual user
    # intervention. This is the ONLY step that may need root.
    if ! $PYTHON -m pip --version &>/dev/null; then
        echo "  pip is not installed — bootstrapping via system package manager..."
        if [ "$EUID" -ne 0 ]; then
            hash sudo 2>/dev/null && prefix="sudo sh -c" \
                || prefix="su root -c"
        else
            prefix="sh -c"
        fi
        if [ -f /etc/debian_version ]; then
            [[ "$prefix" =~ ^su[[:space:]].* ]] && echo -en "  Enter root password: "
            $prefix "apt-get -y -qq install python3-pip" || true
        elif [ -f /etc/redhat-release ]; then
            [[ "$prefix" =~ ^su[[:space:]].* ]] && echo -en "  Enter root password: "
            $prefix "dnf -y install python3-pip" || true
        elif [ -f /etc/arch-release ] || [ -f /etc/manjaro-release ]; then
            [[ "$prefix" =~ ^su[[:space:]].* ]] && echo -en "  Enter root password: "
            $prefix "pacman -S --noconfirm python-pip" || true
        elif [ -f /etc/os-release ] && grep -qi 'opensuse\|sles' /etc/os-release; then
            [[ "$prefix" =~ ^su[[:space:]].* ]] && echo -en "  Enter root password: "
            $prefix "zypper --non-interactive install python3-pip" || true
        else
            echo "  Unknown distro — please install python3-pip manually, then re-run s4."
            exit 1
        fi
        if ! $PYTHON -m pip --version &>/dev/null; then
            echo "  pip bootstrap failed. Install manually: <distro-pkg-mgr> install python3-pip"
            exit 1
        fi
    fi

    echo "  Bootstrapping minimum modules via pip --user (one time)..."
    $PYTHON -m pip install --user --upgrade pyyaml "textual>=5.0" 2>/dev/null \
        || $PYTHON -m pip install --user --upgrade --break-system-packages pyyaml "textual>=5.0" 2>/dev/null
    YAML_OK=$($PYTHON -c "import yaml" 2>/dev/null && echo ok)
    TEXTUAL_OK=$($PYTHON -c "
try:
    import textual
    v = tuple(int(x) for x in textual.__version__.split('.')[:2])
    print('ok' if v >= (5, 0) else 'old')
except ImportError:
    print('missing')
" 2>/dev/null)
    if [ "$YAML_OK" != "ok" ] || [ "$TEXTUAL_OK" != "ok" ]; then
        echo "  Bootstrap failed. Install manually:"
        echo "    $PYTHON -m pip install --user pyyaml 'textual>=5.0'"
        exit 1
    fi
    echo "  Done. Use F1 → 'Check & Install Dependencies' inside s4 for the rest."
fi

exec $PYTHON s4.py "$@"
