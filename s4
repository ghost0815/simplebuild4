#!/bin/bash
# SimpleBuild4 launcher
cd "$(dirname "$(readlink -f "$0")")"

# --- Self-update (./s4 update) — no Python needed ---
if [ "$1" == "update" ]; then
    echo -e "\n  s4 self-update"
    echo -e "  ==============\n"

    if [ -d .git ]; then
        # --- Git repo: fetch + pull ---
        GIT_BRANCH="$(git branch --show-current)"
        git fetch --prune 2>&1 | sed 's/^/  /'

        ahead=$(git rev-list "origin/$GIT_BRANCH..HEAD" --count 2>/dev/null || echo 0)
        behind=$(git rev-list "HEAD..origin/$GIT_BRANCH" --count 2>/dev/null || echo 0)
        local_rev=$(git rev-list HEAD --count)
        local_commit=$(git log HEAD -n1 --oneline)
        online_rev=$(git rev-list "origin/$GIT_BRANCH" --count 2>/dev/null || echo "?")
        online_commit=$(git log "origin/$GIT_BRANCH" -n1 --oneline 2>/dev/null || echo "?")

        if [ "$behind" -eq 0 ] && [ "$ahead" -eq 0 ]; then
            echo -e "  \033[1;32ms4 is up to date\033[0m"
            echo "  Revision $local_rev: $local_commit"
        else
            echo "  Local:  r$local_rev $local_commit"
            echo "  Online: r$online_rev $online_commit"
            echo ""
            git log "HEAD..origin/$GIT_BRANCH" --oneline 2>/dev/null | sed 's/^/    /'
            echo ""

            # Discard any local changes
            git checkout . 2>/dev/null
            git clean -fd 2>/dev/null

            if [ "$ahead" -gt 0 ]; then
                echo "  Resetting to remote (forced push detected)..."
                git reset "origin/$GIT_BRANCH" --hard 2>&1 | sed 's/^/  /'
            else
                echo "  Pulling updates..."
                git pull 2>&1 | sed 's/^/  /'
            fi

            new_rev=$(git rev-list HEAD --count)
            new_commit=$(git log HEAD -n1 --oneline)
            echo -e "\n  \033[1;32mUpdated to r$new_rev: $new_commit\033[0m"
        fi
    else
        # --- No git repo: clone to temp, copy files over (like s3) ---
        S4_URL="https://git.streamboard.tv/common/simplebuild4.git"
        # Try reading URL from settings
        [ -f data/settings.yaml ] && _url=$(grep 's4_url:' data/settings.yaml 2>/dev/null | awk '{print $2}') && [ -n "$_url" ] && S4_URL="$_url"

        echo "  No git repo — updating from $S4_URL"
        S4_TMP="/tmp/s4_update_$$"
        rm -rf "$S4_TMP"

        echo "  Cloning..."
        if ! git clone --depth 1 "$S4_URL" "$S4_TMP" 2>&1 | sed 's/^/  /'; then
            echo -e "  \033[1;31mClone failed\033[0m"
            rm -rf "$S4_TMP"
            exit 1
        fi

        echo "  Updating files..."
        # Copy everything except data/ directory
        for item in "$S4_TMP"/*; do
            name="$(basename "$item")"
            [ "$name" == "data" ] && continue
            [ "$name" == ".git" ] && continue
            rm -rf "./$name"
            cp -rf "$item" "./$name"
            echo "    $name"
        done
        # Hidden files (.gitignore, .gitattributes)
        for item in "$S4_TMP"/.[!.]*; do
            name="$(basename "$item")"
            [ "$name" == ".git" ] && continue
            cp -f "$item" "./$name"
            echo "    $name"
        done

        chmod +x ./s4 2>/dev/null
        rm -rf "$S4_TMP"

        online_rev=$(cd /tmp && git ls-remote "$S4_URL" HEAD | cut -c1-8)
        echo -e "\n  \033[1;32mUpdated to $online_rev\033[0m"
    fi
    echo ""
    exit 0
fi

# --- Find Python 3.10+ ---
PYTHON=""
for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$py" &>/dev/null; then
        ver=$("$py" -c "import sys; print(sys.version_info >= (3,10))" 2>/dev/null)
        if [ "$ver" == "True" ]; then
            PYTHON="$py"
            break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    echo -e "\n  s4 requires Python 3.10 or newer."
    echo "  Found: $(python3 --version 2>/dev/null || echo 'none')"
    echo "  Install Python 3.10+ or compile from source."
    exit 1
fi

# --- Check Python modules ---
missing=()
$PYTHON -c "import textual" 2>/dev/null || missing+=("python3-textual")
$PYTHON -c "import yaml" 2>/dev/null   || missing+=("python3-yaml")

if [ ${#missing[@]} -gt 0 ]; then
    echo -e "\n  s4 requires: ${missing[*]}\n"

    # Determine how to get root
    rootuser="$(ps -jf 1 | tail -n 1 | awk '{print $1}')"
    if [ "$EUID" -ne 0 ]; then
        ! hash "sudo" 2>/dev/null && prefix="su $rootuser -c" || prefix="sudo sh -c"
    else
        prefix="sh -c"
    fi

    # Detect package manager
    if [ -f /etc/debian_version ]; then
        echo "  Installing via apt..."
        [[ "$prefix" =~ ^su[[:space:]].* ]] && echo -en "\n  Enter $rootuser password: "
        $prefix "apt-get -y -qq install ${missing[*]}" || exit 1
    elif [ -f /etc/redhat-release ]; then
        echo "  Installing via dnf..."
        $prefix "dnf -y install ${missing[*]}" || exit 1
    elif [ -f /etc/arch-release ] || [ -f /etc/manjaro-release ]; then
        echo "  Installing via pacman..."
        $prefix "pacman -S --noconfirm ${missing[*]}" || exit 1
    else
        echo "  Please install manually: ${missing[*]}"
        exit 1
    fi

    # Verify
    $PYTHON -c "import textual" 2>/dev/null && $PYTHON -c "import yaml" 2>/dev/null || {
        echo -e "\n  Installation failed. Please install manually: ${missing[*]}"
        exit 1
    }
    echo -e "  Done.\n"
fi

exec $PYTHON s4.py "$@"
